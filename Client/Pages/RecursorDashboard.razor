    private static MarkupString FormatHypothesisBadges(string? json)
    {
        if (string.IsNullOrEmpty(json) || json == "null" || json == "[]")
            return (MarkupString)"<span class=\"text-muted\" style=\"font-size:0.72rem\">(no patterns)</span>";
        try
        {
            using var doc = JsonDocument.Parse(json);
            var badges = doc.RootElement
                .EnumerateArray()
                .Select(e => e.GetString() ?? "")
                .Where(s => s.Length > 0)
                .Select(s => $"<span class=\"badge bg-secondary me-1\" style=\"font-size:0.7rem\">{s}</span>")
                .ToList();
            return badges.Count > 0
                ? (MarkupString)string.Concat(badges)
                : (MarkupString)"<span class=\"text-muted\" style=\"font-size:0.72rem\">(no patterns)</span>";
        }
        catch
        {
            return (MarkupString)"<span class=\"text-muted\" style=\"font-size:0.72rem\">(parse error)</span>";
        }
    }

    private static MarkupString MaybeLineMarkup(string label, string? value, int maxLen)
    {
        if (string.IsNullOrEmpty(value)) return (MarkupString)"";
        var display = value.Length > maxLen ? value[..maxLen] + "…" : value;
        return (MarkupString)$"<div class=\"mt-1\"><strong>{label}:</strong> {display}</div>";
