@page "/recursor-dashboard"
@using NCATAIBlazorFrontendTest.Shared
@using System.Text.Json
@inject HttpClient Http

<PageTitle>Recursor Dashboard</PageTitle>

<h2>Recursor Evaluation Dashboard</h2>
<p class="text-muted">
    Internal demo tool — behavior &rarr; state &rarr; adaptation &rarr; prediction &rarr; outcome.
    &nbsp;|&nbsp; <a href="/recursor-sims">Browse by Sim / User / Session &rarr;</a>
</p>

<!-- ── Elevated-risk model comparison ───────────────────────────────── -->
<div class="mb-3">
    <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleModelComparison">
        @(_showModelComparison ? "Hide" : "Show") Elevated-Risk Model Comparison
    </button>
    @if (_showModelComparison)
    {
        @if (_loadingComparison)
        {
            <p class="mt-2"><em>Loading comparison...</em></p>
        }
        else if (_comparisonError is not null)
        {
            <div class="alert alert-warning mt-2">@_comparisonError</div>
        }
        else if (_comparisonResult is not null && _comparisonResult.Status != DashboardQueryStatus.Success)
        {
            <!-- Stage 7: a query failure is never rendered as "no data" — always a distinct, visible error state. -->
            <div class="alert alert-danger mt-2">
                <strong>@_comparisonResult.Status</strong>: @DescribeQueryStatus(_comparisonResult.Status)
                @if (!string.IsNullOrEmpty(_comparisonResult.ErrorMessage))
                {
                    <div class="small mt-1">@_comparisonResult.ErrorMessage</div>
                }
            </div>
        }
        else if (_comparisonResult is not null)
        {
            @if (_comparisonResult.Rows.Count == 0)
            {
                <p class="text-muted mt-2">No comparison data — train at least one model and run validation sessions to populate TemporalElevatedRiskPredictions.</p>
            }
            else
            {
                <h6 class="mt-2">Elevated-Risk Model Comparison (shadow-only)</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered" style="font-size:0.82rem">
                        <thead class="table-dark">
                            <tr>
                                <th>ModelVersion</th>
                                <th class="text-center">Horizon</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">Accuracy</th>
                                <th class="text-center">ElevPrec</th>
                                <th class="text-center">ElevRecall</th>
                                <th class="text-center">ElevF1</th>
                                <th class="text-center">FP</th>
                                <th class="text-center">FN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in _comparisonResult.Rows)
                            {
                                <tr>
                                    <td><code>@row.ModelVersion</code></td>
                                    <td class="text-center">H@row.Horizon</td>
                                    <td class="text-center">@row.Total</td>
                                    <td class="text-center">@FormatPct(row.Accuracy)</td>
                                    <td class="text-center">@FormatPct(row.ElevatedPrecision)</td>
                                    <td class="text-center">@FormatPct(row.ElevatedRecall)</td>
                                    <td class="text-center">@FormatPct(row.ElevatedF1)</td>
                                    <td class="text-center">@row.FalsePositive</td>
                                    <td class="text-center">@row.FalseNegative</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="text-muted small">Predictions are shadow-only and do not affect adaptation decisions. Compare rows across ModelVersion to evaluate retraining.</p>
            }
        }
    }
</div>

<!-- ── Behavior-state model comparison (Phase 10E, shadow-only) ────────── -->
<div class="mb-3">
    <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleBehaviorStateComparison">
        @(_showBehaviorStateComparison ? "Hide" : "Show") Behavior-State Temporal Prediction — Shadow-only behavior-state prediction
    </button>
    @if (_showBehaviorStateComparison)
    {
        <!-- Stage 7/11: simulation/scenario/model-version/horizon filters — never imply
             predictions control adaptations. -->
        <div class="d-flex flex-wrap align-items-center gap-3 mt-2 mb-1" style="font-size:0.85rem">
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted">Simulation:</span>
                <select class="form-select form-select-sm" style="width:auto" value="@_behaviorStateSimFilter" @onchange="OnBehaviorStateFilterChangedAsync">
                    @foreach (var opt in BehaviorStateSimOptions)
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted">Horizon:</span>
                <select class="form-select form-select-sm" style="width:auto" value="@_behaviorStateHorizonFilter" @onchange="OnBehaviorStateHorizonFilterChangedAsync">
                    @foreach (var opt in BehaviorStateHorizonOptions)
                    {
                        <option value="@opt.Value">@opt.Label</option>
                    }
                </select>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted">Scenario:</span>
                <input class="form-control form-control-sm" style="width:160px" placeholder="all scenarios"
                       value="@_behaviorStateScenarioFilter" @onchange="OnBehaviorStateScenarioFilterChangedAsync" />
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted">Model version:</span>
                <input class="form-control form-control-sm" style="width:200px" placeholder="all versions"
                       value="@_behaviorStateModelVersionFilter" @onchange="OnBehaviorStateModelVersionFilterChangedAsync" />
            </div>
        </div>

        @if (_loadingBehaviorStateComparison)
        {
            <p class="mt-2"><em>Loading comparison...</em></p>
        }
        else if (_behaviorStateComparisonError is not null)
        {
            <div class="alert alert-warning mt-2">@_behaviorStateComparisonError</div>
        }
        else if (_behaviorStateComparisonResult is not null && _behaviorStateComparisonResult.Status != DashboardQueryStatus.Success)
        {
            <!-- Stage 11: a query failure is never rendered as "no data" — always a distinct, visible error state. -->
            <div class="alert alert-danger mt-2">
                <strong>@_behaviorStateComparisonResult.Status</strong>: @DescribeQueryStatus(_behaviorStateComparisonResult.Status)
                @if (!string.IsNullOrEmpty(_behaviorStateComparisonResult.ErrorMessage))
                {
                    <div class="small mt-1">@_behaviorStateComparisonResult.ErrorMessage</div>
                }
            </div>
        }
        else if (_behaviorStateComparisonResult is not null)
        {
            @if (_behaviorStateComparisonResult.Rows.Count == 0)
            {
                <p class="text-muted mt-2">No comparison data for this filter — train a behavior-state model (POST /api/recursor/train-temporal-behavior-state), enable Recursor:Policies:EnableTemporalBehaviorStatePrediction, and run validation sessions to populate TemporalBehaviorStatePredictions.</p>
            }
            else
            {
                <p class="text-muted small mt-2 mb-1">
                    <strong>Shadow-only behavior-state prediction.</strong> This panel is purely
                    observational — it never controls adaptation decisions, guardrails, policy
                    selection, hint behavior, difficulty, or time pressure.
                </p>
                @foreach (var group in _behaviorStateComparisonResult.Rows.GroupBy(r => (r.ModelVersion, r.Horizon)).OrderBy(g => g.Key.ModelVersion).ThenBy(g => g.Key.Horizon))
                {
                    var rows = group.ToList();
                    var totalSupport = rows.Sum(r => r.SupportCount);
                    var totalTruePositive = rows.Sum(r => r.TruePositive);
                    var microAccuracy = totalSupport > 0 ? (double?)totalTruePositive / totalSupport : null;
                    var macroF1 = rows.Count > 0 ? rows.Where(r => r.F1.HasValue).Select(r => r.F1!.Value).DefaultIfEmpty(0).Average() : (double?)null;

                    <h6 class="mt-3"><code>@group.Key.ModelVersion</code> — H@group.Key.Horizon
                        <span class="text-muted small">(MicroAccuracy: @FormatPct(microAccuracy), MacroF1: @FormatPct(macroF1))</span>
                    </h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered" style="font-size:0.82rem">
                            <thead class="table-dark">
                                <tr>
                                    <th>Class</th>
                                    <th class="text-center">Support</th>
                                    <th class="text-center">Predicted</th>
                                    <th class="text-center">TP</th>
                                    <th class="text-center">Precision</th>
                                    <th class="text-center">Recall</th>
                                    <th class="text-center">F1</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in rows.OrderBy(r => r.ClassLabel))
                                {
                                    <tr>
                                        <td>@StateBadge(row.ClassLabel)</td>
                                        <td class="text-center">@row.SupportCount</td>
                                        <td class="text-center">@row.PredictedCount</td>
                                        <td class="text-center">@row.TruePositive</td>
                                        <td class="text-center">@FormatPct(row.Precision)</td>
                                        <td class="text-center">@FormatPct(row.Recall)</td>
                                        <td class="text-center">@FormatPct(row.F1)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        }

        @if (_behaviorStateCoverageResult is not null && _behaviorStateCoverageResult.Status != DashboardQueryStatus.Success)
        {
            <div class="alert alert-danger mt-2">
                <strong>@_behaviorStateCoverageResult.Status</strong>: @DescribeQueryStatus(_behaviorStateCoverageResult.Status)
            </div>
        }
        else if (_behaviorStateCoverageResult is not null && _behaviorStateCoverageResult.Rows.Count > 0)
        {
            <h6 class="mt-3">Prediction coverage</h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered" style="font-size:0.82rem">
                    <thead class="table-dark">
                        <tr>
                            <th>ModelVersion</th>
                            <th class="text-center">Horizon</th>
                            <th class="text-center">Resolved</th>
                            <th class="text-center">Pending</th>
                            <th class="text-center">Missing target</th>
                            <th class="text-center">Unknown target</th>
                            <th class="text-center">Invalid target</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in _behaviorStateCoverageResult.Rows.GroupBy(r => (r.ModelVersion, r.Horizon)).OrderBy(g => g.Key.ModelVersion).ThenBy(g => g.Key.Horizon))
                        {
                            <tr>
                                <td><code>@group.Key.ModelVersion</code></td>
                                <td class="text-center">H@group.Key.Horizon</td>
                                <td class="text-center">@(group.FirstOrDefault(r => r.Coverage == "resolved")?.Count ?? 0)</td>
                                <td class="text-center">@(group.FirstOrDefault(r => r.Coverage == "pending")?.Count ?? 0)</td>
                                <td class="text-center">@(group.FirstOrDefault(r => r.Coverage == "missing-target")?.Count ?? 0)</td>
                                <td class="text-center">@(group.FirstOrDefault(r => r.Coverage == "unknown-target")?.Count ?? 0)</td>
                                <td class="text-center">@(group.FirstOrDefault(r => r.Coverage == "invalid-target")?.Count ?? 0)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted small">"Missing target" = no target ever stamped for that window. "Unknown target" = the guardrail found no signal (not an error). "Invalid target" = an unrecognized label literal. None of these three are ever counted as an incorrect prediction. "Pending" = the target window hasn't happened yet.</p>
        }

        <!-- Stage 7: confusion matrix — actual (row) vs predicted (column) counts for the same
             filtered selection as the panels above, using the five canonical classes. -->
        @if (_behaviorStateConfusionMatrixResult is not null && _behaviorStateConfusionMatrixResult.Status != DashboardQueryStatus.Success)
        {
            <div class="alert alert-danger mt-2">
                <strong>@_behaviorStateConfusionMatrixResult.Status</strong>: @DescribeQueryStatus(_behaviorStateConfusionMatrixResult.Status)
            </div>
        }
        else if (_behaviorStateConfusionMatrixResult is not null && _behaviorStateConfusionMatrixResult.Rows.Count > 0)
        {
            @foreach (var group in _behaviorStateConfusionMatrixResult.Rows.GroupBy(r => (r.ModelVersion, r.Horizon)).OrderBy(g => g.Key.ModelVersion).ThenBy(g => g.Key.Horizon))
            {
                var cells = group.ToList();
                var classes = BehaviorStateLabelPolicy.CanonicalLabels;
                <h6 class="mt-3"><code>@group.Key.ModelVersion</code> — H@group.Key.Horizon confusion matrix
                    <span class="text-muted small">(rows = actual, columns = predicted)</span>
                </h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered text-center" style="font-size:0.78rem; max-width:520px">
                        <thead class="table-dark">
                            <tr>
                                <th>Actual \ Predicted</th>
                                @foreach (var predicted in classes)
                                {
                                    <th>@predicted</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var actual in classes)
                            {
                                <tr>
                                    <th class="table-dark">@actual</th>
                                    @foreach (var predicted in classes)
                                    {
                                        var count = cells.FirstOrDefault(c => c.ActualClass == actual && c.PredictedClass == predicted)?.Count ?? 0;
                                        <td class="@(actual == predicted ? "table-success fw-bold" : count > 0 ? "table-warning" : "")">@count</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    }
</div>

@if (_loadingList)
{
    <p><em>Loading recent sessions...</em></p>
}
else if (_listError is not null)
{
    <div class="alert alert-warning">@_listError</div>
}
else if (_sessionsResult is not null && _sessionsResult.Status != DashboardQueryStatus.Success)
{
    <!-- Stage 7: an ADX failure must never render as "No sessions found" — always a distinct,
         visible error state. -->
    <div class="alert alert-danger">
        <strong>@_sessionsResult.Status</strong>: @DescribeQueryStatus(_sessionsResult.Status)
        @if (!string.IsNullOrEmpty(_sessionsResult.ErrorMessage))
        {
            <div class="small mt-1">@_sessionsResult.ErrorMessage</div>
        }
    </div>
}
else if (_sessionsResult is not null)
{
    @if (_selectedSessionId is null)
    {
        <!-- ── Recent sessions table ─────────────────────────── -->
        <h5>Recent Sessions <span class="badge bg-secondary">@_sessionsResult.Rows.Count</span></h5>
        @if (_sessionsResult.Rows.Count == 0)
        {
            <p class="text-muted">No sessions found in ADX. Run a session to populate data.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Session</th>
                            <th>User</th>
                            <th>Sim</th>
                            <th>Scenario</th>
                            <th class="text-center">Windows</th>
                            <th class="text-center">Adapt</th>
                            <th class="text-center">Preds</th>
                            <th>Last Active</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _sessionsResult.Rows)
                        {
                            <tr>
                                <td><code>@Truncate(s.SessionId, 12)</code></td>
                                <td>@s.UserId</td>
                                <td>@s.SimId</td>
                                <td>@s.ScenarioId</td>
                                <td class="text-center">@s.WindowCount</td>
                                <td class="text-center">@s.AdaptationCount</td>
                                <td class="text-center">@s.PredictionCount</td>
                                <td>@s.LastSeenUtc.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => LoadTimeline(s.SessionId)">
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <!-- ── Session timeline ───────────────────────────────── -->
        <div class="mb-2">
            <button class="btn btn-sm btn-secondary" @onclick="ClearTimeline">&larr; Back to sessions</button>
            <span class="ms-2 text-muted">Session: <code>@_selectedSessionId</code></span>
        </div>

        @if (_loadingTimeline)
        {
            <p><em>Loading session timeline...</em></p>
        }
        else if (_timelineError is not null)
        {
            <div class="alert alert-warning">@_timelineError</div>
        }
        else if (_selectedTimelineResult is not null && _selectedTimelineResult.Status != DashboardQueryStatus.Success)
        {
            <!-- Stage 7: a query failure is never rendered as "no prediction data exists" —
                 always a distinct, visible diagnostic state, never a silent empty timeline. -->
            <div class="alert alert-danger">
                <strong>@_selectedTimelineResult.Status</strong>: @DescribeQueryStatus(_selectedTimelineResult.Status)
                @if (!string.IsNullOrEmpty(_selectedTimelineResult.ErrorMessage))
                {
                    <div class="small mt-1">@_selectedTimelineResult.ErrorMessage</div>
                }
            </div>
        }
        else if (_selectedTimelineResult is null || _selectedTimelineResult.Value is null)
        {
            <!-- The query succeeded and genuinely found nothing for this session. -->
            <p class="text-muted">No prediction data exists for this session yet.</p>
        }
        else
        {
            var t = _selectedTimelineResult.Value;

            @if (_availableBehaviorStateVersions.Count > 1)
            {
                <!-- Stage 7: explicit model-version selector — mirrors the pattern already used
                     by RecursorSimSessionDetail.razor's session-detail page. -->
                <div class="d-flex align-items-center gap-2 mb-2" style="font-size:0.85rem">
                    <span class="text-muted">Behavior-state model version:</span>
                    <select class="form-select form-select-sm" style="width:auto" value="@t.SelectedBehaviorStateModelVersion" @onchange="OnBehaviorStateVersionChangedAsync">
                        @foreach (var v in _availableBehaviorStateVersions)
                        {
                            <option value="@v">@v</option>
                        }
                    </select>
                </div>
            }

            <!-- Summary cards -->
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="fs-4 fw-bold">@t.TotalWindows</div>
                        <div class="text-muted small">Windows</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="fs-4 fw-bold">@t.TotalAdaptations</div>
                        <div class="text-muted small">Adaptations</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="fs-4 fw-bold">@t.TotalPredictions</div>
                        <div class="text-muted small">Predictions</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card text-center py-2">
                        <div class="fs-4 fw-bold">@FormatPct(t.AveragePredictionConfidence)</div>
                        <div class="text-muted small">Avg Confidence</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center py-2">
                        <div class="fs-5 fw-bold">@FormatPct(t.H1PredictionAccuracy)</div>
                        <div class="text-muted small">H1 Accuracy (next window)</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center py-2">
                        <div class="fs-5 fw-bold">@FormatPct(t.H2PredictionAccuracy)</div>
                        <div class="text-muted small">H2 Accuracy (+2 windows)</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center py-2">
                        <div class="fs-5 fw-bold">@FormatPct(t.H3PredictionAccuracy)</div>
                        <div class="text-muted small">H3 Accuracy (+3 windows)</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center py-2">
                        <div class="fs-5 fw-bold">@FormatPct(t.H1BehaviorStateAccuracy)</div>
                        <div class="text-muted small">H1 Behavior-State Accuracy (shadow-only)</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center py-2">
                        <div class="fs-5 fw-bold">@FormatPct(t.H2BehaviorStateAccuracy)</div>
                        <div class="text-muted small">H2 Behavior-State Accuracy (shadow-only)</div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="card text-center py-2">
                        <div class="fs-5 fw-bold">@FormatPct(t.H3BehaviorStateAccuracy)</div>
                        <div class="text-muted small">H3 Behavior-State Accuracy (shadow-only)</div>
                    </div>
                </div>
            </div>

            <!-- Timeline table -->
            <div class="table-responsive">
                <table class="table table-sm table-bordered" style="font-size:0.82rem">
                    <thead class="table-dark">
                        <tr>
                            <th>Win</th>
                            <th>State</th>
                            <th>Confusion</th>
                            <th>Goal</th>
                            <th>Hint</th>
                            <th>Risk</th>
                            <th>Seq</th>
                            <th>Vol</th>
                            <th>Mom</th>
                            <th>Adaptation</th>
                            <th>Policy Notes</th>
                            <th>Coach / Explanation</th>
                            <th>H1 Pred/Target</th>
                            <th>H2 Pred/Target</th>
                            <th>H3 Pred/Target</th>
                            <th>H1 State (shadow)</th>
                            <th>H2 State (shadow)</th>
                            <th>H3 State (shadow)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in t.Windows)
                        {
                            <tr class="@StateRowClass(w.GuardrailOverallBehaviorState)">
                                <td class="fw-bold">@w.WindowIndex</td>
                                <td>@StateBadge(w.GuardrailOverallBehaviorState)</td>
                                <td>@w.ConfusionScore.ToString("F2")</td>
                                <td>@w.GoalUnderstanding.ToString("F2")</td>
                                <td>@w.HintDependenceScore.ToString("F2")</td>
                                <td>@RiskBadge(w.PredictedNearTermRisk)</td>
                                <td class="text-muted">@w.SequenceWindowCount</td>
                                <td class="text-muted">@w.VolatilityScore.ToString("F2")</td>
                                <td class="text-muted">@w.MomentumScore.ToString("F2")</td>
                                <td>
                                    @if (w.AdaptationDecision is not null)
                                    {
                                        var ad = w.AdaptationDecision;
                                        <span class="badge bg-info text-dark">@FormatFamilies(ad.InterventionFamiliesJson)</span>
                                        @if (!string.IsNullOrEmpty(ad.ReasoningSummary))
                                        {
                                            <div class="text-muted" style="font-size:0.75rem">@TruncateStr(ad.ReasoningSummary, 60)</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td style="font-size:0.75rem">
                                    @if (w.AdaptationDecision is not null)
                                    {
                                        var ad = w.AdaptationDecision;
                                        @if (!string.IsNullOrEmpty(ad.Phase8AGuardrailNotes))
                                        {
                                            <div><span class="badge bg-warning text-dark">8A</span> @ad.Phase8AGuardrailNotes</div>
                                        }
                                        @if (!string.IsNullOrEmpty(ad.Phase8EReliabilityNotes))
                                        {
                                            <div><span class="badge bg-secondary">8E</span> @ad.Phase8EReliabilityNotes</div>
                                        }
                                        @if (!string.IsNullOrEmpty(ad.Phase10TrajectoryNotes))
                                        {
                                            <div><span class="badge bg-dark">10A</span> @ad.Phase10TrajectoryNotes</div>
                                        }
                                    }
                                </td>
                                <td style="font-size:0.75rem; max-width:220px">
                                    @if (w.AdaptationDecision is not null)
                                    {
                                        var ad = w.AdaptationDecision;
                                        @if (HasExplanation(ad))
                                        {
                                            <details>
                                                <summary style="cursor:pointer">@FormatHypothesisBadges(ad.HypothesisLabelsJson)</summary>
                                                @MaybeLineMarkup("State",  ad.LearnerStateSummary, 100)
                                                @MaybeLineMarkup("Why",    ad.WhySupportChanged,   100)
                                                @MaybeLineMarkup("Coach",  ad.CoachMessage,        100)
                                                @MaybeLineMarkup("Conf",   ad.ConfidenceNote,      80)
                                            </details>
                                        }
                                        else if (!string.IsNullOrEmpty(ad.ReasoningSummary))
                                        {
                                            <span class="text-muted">@TruncateStr(ad.ReasoningSummary, 60)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>@HorizonCell(w, 1)</td>
                                <td>@HorizonCell(w, 2)</td>
                                <td>@HorizonCell(w, 3)</td>
                                <td>@BehaviorStateHorizonCell(w, 1)</td>
                                <td>@BehaviorStateHorizonCell(w, 2)</td>
                                <td>@BehaviorStateHorizonCell(w, 3)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p class="text-muted small mt-1">
                Win = window index &bull; State = guardrail behavior state &bull;
                Risk = trajectory near-term risk &bull; Seq = sequence window count &bull;
                Vol = volatility &bull; Mom = momentum &bull;
                Coach / Explanation = click to expand detected patterns and GPT explanation (older rows may be blank) &bull;
                H1/H2/H3 Pred/Target = near-term-risk temporal prediction horizon vs observed target (✓ correct / ✗ wrong / — not yet available) &bull;
                H1/H2/H3 State (shadow) = Phase 10E shadow-only behavior-state prediction vs eventual outcome — observational only, never controls adaptation
            </p>
        }
    }
}

