    private static MarkupString StateBadge(string state)
    {
        var canonical = BehaviorStateLabelPolicy.Normalize(state).CanonicalLabel ?? state;
        var cls = canonical switch
        {
            "struggling"  => "bg-danger",
            "recovering"  => "bg-warning text-dark",
            "mastering"   => "bg-success",
            "stable"      => "bg-primary",
            "conflicted"  => "bg-secondary",
            _             => "bg-light text-dark"
        };
        return (MarkupString)$"<span class=\"badge {cls}\">{canonical}</span>";
    }

    private static MarkupString RiskBadge(string risk)
    {
        var cls = risk switch
        {
            "high"   => "bg-danger",
            "medium" => "bg-warning text-dark",
            "low"    => "bg-success",
            _        => "bg-light text-dark"
        };
        var label = string.IsNullOrEmpty(risk) ? "—" : risk;
        return (MarkupString)$"<span class=\"badge {cls}\">{label}</span>";
    }

    private static string FormatFamilies(string json)
    {
        if (string.IsNullOrEmpty(json) || json == "null") return "—";
        try
        {
            using var doc = JsonDocument.Parse(json);
            var items = doc.RootElement
                .EnumerateArray()
                .Select(e => e.GetString() ?? "")
                .Where(s => s.Length > 0);
            return string.Join(", ", items);
        }
        catch
        {
            return json;
        }
    }

    private static MarkupString HorizonCell(WindowTimelineDto w, int horizon)
    {
        var pred   = w.TemporalRiskPredictions.FirstOrDefault(p => p.Horizon == horizon);
        var target = w.TemporalPredictionTargets.FirstOrDefault(t => t.Horizon == horizon);
        var correct = horizon == 1 ? w.H1PredictionCorrect
                    : horizon == 2 ? w.H2PredictionCorrect
                    :                w.H3PredictionCorrect;

        if (pred is null && target is null)
            return (MarkupString)"<span class=\"text-muted\">—</span>";

        var predLabel  = pred   is not null ? RiskBadgeHtml(pred.PredictedNearTermRisk)   : "—";
        var targetLabel = target is not null ? RiskBadgeHtml(target.TargetNearTermRisk) : "?";
        var correctIcon = correct switch
        {
            true  => "<span class=\"text-success fw-bold\">✓</span>",
            false => "<span class=\"text-danger fw-bold\">✗</span>",
            null  => "<span class=\"text-muted\">—</span>"
        };

        return (MarkupString)$"{predLabel}&rarr;{targetLabel} {correctIcon}";
    }

    private static MarkupString BehaviorStateHorizonCell(WindowTimelineDto w, int horizon)
    {
        var pred   = w.BehaviorStatePredictions.FirstOrDefault(p => p.Horizon == horizon);
        var target = w.TemporalPredictionTargets.FirstOrDefault(t => t.Horizon == horizon);
        var correct = horizon == 1 ? w.H1BehaviorStateCorrect
                    : horizon == 2 ? w.H2BehaviorStateCorrect
                    :                w.H3BehaviorStateCorrect;

        if (pred is null && target is null)
            return (MarkupString)"<span class=\"text-muted\">—</span>";

        var predLabel = pred is not null ? StateBadge(pred.PredictedBehaviorState).Value : "—";
        // Stage 5 (corrective pass): resolves through the same BehaviorStateLabelPolicy the
        // server-side correctness calculation (DashboardTimelineBuilder.ComputeBehaviorStateCorrectness)
        // already uses, instead of a separate `!= "unknown"` check — so the label shown here and
        // the ✓/✗ correctness icon next to it can never disagree about what counts as "pending".
        var targetLabel = BehaviorStateLabelPolicy.Normalize(target?.TargetBehaviorState).IsTrainable
            ? StateBadge(target!.TargetBehaviorState).Value
            : "<span class=\"text-muted\">pending</span>";
        var correctIcon = correct switch
        {
            true  => "<span class=\"text-success fw-bold\">✓</span>",
            false => "<span class=\"text-danger fw-bold\">✗</span>",
            null  => "<span class=\"text-muted\">—</span>"
        };

        return (MarkupString)$"{predLabel}&rarr;{targetLabel} {correctIcon}";
    }

    private static string RiskBadgeHtml(string risk)
    {
        var cls = risk switch
        {
            "high"   => "bg-danger",
            "medium" => "bg-warning text-dark",
            "low"    => "bg-success",
            _        => "bg-light text-dark"
        };
        var label = string.IsNullOrEmpty(risk) ? "?" : risk;
        return $"<span class=\"badge {cls}\">{label}</span>";
    }

