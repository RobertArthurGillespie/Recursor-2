{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        },
        "ApplicationInsights": {
            "LogLevel": {
                "Default": "Information",
                "Microsoft.AspNetCore": "Warning"
            }
        }
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Key": "",
        "Issuer": "NCAT-AI-App",
        "Audience": "NCAT-AI-Users"
    },
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Recursor": {
        "Models": {
            "HintDependenceModelPath": "Recursor/TrainingModels/hint_dependence_v1.zip",
            "ConfusionModelPath": "Recursor/TrainingModels/confusion_v1.zip",
            "StableMasteryModelPath": "Recursor/TrainingModels/stable_mastery_v1.zip",
            "HintDependenceNextWindowModelPath": "Recursor/TrainingModels/hint_dependence_next_window_baseline.zip",
            "TemporalRiskH1ModelPath": "Recursor/TrainingModels/temporal_risk_h1_v1.zip",
            "TemporalRiskH2ModelPath": "Recursor/TrainingModels/temporal_risk_h2_v1.zip",
            "TemporalRiskH3ModelPath": "Recursor/TrainingModels/temporal_risk_h3_v1.zip",
            "TemporalElevatedRiskModelVersion": "temporal-elevated-risk-v2",
            "TemporalElevatedRiskH1ModelPath": "Recursor/TrainingModels/temporal_elevated_risk_h1_v2.zip",
            "TemporalElevatedRiskH2ModelPath": "Recursor/TrainingModels/temporal_elevated_risk_h2_v2.zip",
            "TemporalElevatedRiskH3ModelPath": "Recursor/TrainingModels/temporal_elevated_risk_h3_v2.zip",
            "TemporalBehaviorStateModelVersion": "temporal-behavior-state-v1"
        },
        "Policies": {
            "EnablePhase8AGuardrailModifier": true,
            "EnableTemporalBehaviorStatePrediction": false,
            "EnableNextWindowHintDependenceGuardrail": false,
            "HintDependenceNextModerateThreshold": 0.45,
            "HintDependenceNextHighThreshold": 0.70,

            "EnablePersonalizedHintFadeRule": true,
            "PersonalizedHintFadeConfusionDeltaThreshold": -0.05,
            "PersonalizedHintFadeHintDependenceDeltaThreshold": -0.05,

            "EnablePersonalizedConfusionBlockDifficultyRule": true,
            "PersonalizedConfusionBlockDifficultyIncreaseThreshold": 0.05,

            "EnablePersonalizedDifficultyAccelerationRule": true,
            "PersonalizedDifficultyAccelerationConfusionDeltaThreshold": -0.08,
            "PersonalizedDifficultyAccelerationHintDependenceDeltaThreshold": -0.08,
            "PersonalizedDifficultyAccelerationMaxCurrentConfusionScore": 0.25,
            "PersonalizedDifficultyAccelerationMinCurrentGoalUnderstanding": 0.70,
            "PersonalizedDifficultyAccelerationDelta": 0.08,

            "EnableModelTraining": true,
            "ModelTrainingAllowedEnvironments": [ "Development" ]
        },
        "PolicyReliability": {
            "Mode": "active",
            "EnableConditionalSuppression": false,
            "EnableConditionalPromotionProtection": true,
            "FamilyReliabilityTiers": {
                "difficulty-reduction": "risky"
            },
            "ConditionalFamilyReliabilityTiers": {
                "difficulty-reduction": {
                    "GuardrailOverallBehaviorState=struggling": "promising"
                }
            }
        }
    },
    "Adx": {
        "ClusterUri": "https://recursor-adx-cluster.eastus.kusto.windows.net",
        "IngestUri": "https://ingest-recursor-adx-cluster.eastus.kusto.windows.net",
        "Database": "RecursorDbMain",
        "TenantId": "f80d0d1d-def8-4508-b92a-865bccae6c6e",
        "ClientId": "",
        "ClientSecret": "",
        "AuthMode": "UserPrompt"
    },
    "TestConfig": {
